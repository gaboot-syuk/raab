# Konteks build sengaja dibuat kecil: berkas proyek di-*bind mount* saat
# menjalankan container, bukan disalin ke dalam image.
vendor
node_modules
storage
bootstrap/cache
public/build
public/hot
docs
.git
.github
*.md
.env
.phpunit.result.cache

# Tes tidak perlu ikut ke dalam citra produksi. `composer install --no-dev`
# tidak memasang PHPUnit, jadi tes memang tidak akan pernah bisa dijalankan di
# sana — mengirimnya hanya menambah isi citra tanpa guna.
#
# Ini diabaikan di SINI, bukan di `.gitignore`, supaya tesnya tetap tersimpan
# lengkap di repositori sementara citra tetap ramping.
tests
