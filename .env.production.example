# ============================================================
# Contoh konfigurasi PRODUKSI — PMII Rayon Ali Ahmad Baktsir
#
# Salin menjadi `.env` di server, lalu isi setiap nilai yang bertanda
# "WAJIB DIISI". Berkas `.env` TIDAK PERNAH masuk git.
#
# Aturan yang paling sering dilanggar: JANGAN menyalin .env dari laptop apa
# adanya. APP_KEY yang sama di dua tempat berarti sesi di satu tempat bisa
# dibaca di tempat lain.
# ============================================================

# --- Identitas aplikasi -------------------------------------

APP_NAME="PMII RAAB"
APP_ENV=production
APP_KEY=

# WAJIB: false. Dengan true, setiap galat menampilkan isi berkas dan potongan
# konfigurasi kepada siapa pun yang membukanya.
APP_DEBUG=false

# WAJIB DIISI: alamat asli, lengkap dengan https:// dan tanpa garis miring di
# akhir. Alamat yang salah membuat tautan di email dan berkas media menunjuk
# ke tempat yang tidak ada.
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

# --- Basis data ---------------------------------------------

# MySQL/MariaDB (produksi). Untuk hosting gratis berbasis MySQL, nilai-nilai
# ini berasal dari panel penyedia.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sesi, cache, antrean -----------------------------------

# PENTING: `database` untuk sesi dan cache supaya isinya tidak hilang saat
# wadah dinyalakan ulang. Hosting gratis sering mematikan wadah yang menganggur,
# dan sesi yang disimpan di berkas akan hilang bersama wadahnya — pengurus
# akan terlempar keluar setiap beberapa menit.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=database

QUEUE_CONNECTION=database
# Kalau penyedia memberi Redis, keduanya bisa diubah menjadi redis.
# REDIS_HOST=
# REDIS_PORT=6379

# --- Surat --------------------------------------------------

# Perhatikan: kata sandi SMTP JANGAN pernah dimasukkan ke berkas yang ikut
# git. Untuk Brevo/Mailgun/Resend, pakai kuncinya sebagai kata sandi.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Penyimpanan berkas -------------------------------------

# `public` untuk penyimpanan lokal. Untuk Cloudflare R2 / S3, ubah
# FILESYSTEM_DISK dan isi bagian AWS di bawah.
FILESYSTEM_DISK=public

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Penjadwal tanpa cron -----------------------------------

# WAJIB DIISI di hosting yang tidak menyediakan cron.
#
# Isi dengan rangkaian acak yang panjang, misalnya hasil `openssl rand -hex 32`.
# Lalu daftarkan alamat berikut di layanan penjadwal (cron-job.org, UptimeRobot
# dengan pemantauan HTTP, atau sejenisnya) untuk dipanggil setiap 5 menit:
#
#   https://ALAMAT-SITUS/internal/scheduler/ISI-TOKEN-NYA
#
# Selama nilainya kosong, alamat itu menjawab 404 — fitur yang belum
# dikonfigurasi memang harus mati, bukan terbuka.
SCHEDULER_TOKEN=

# --- Captcha pada formulir publik ---------------------------

# Kosong = nonaktif. Formulir tetap berfungsi, hanya tanpa captcha.
# Isi `turnstile` atau `recaptcha` untuk mengaktifkan.
#
# Perhatian: kalau PENYEDIA sudah diisi tetapi salah satu kuncinya kosong,
# captcha dianggap NONAKTIF dan sebuah peringatan ditulis ke log. Setengah
# terpasang bukan berarti setengah terlindungi.
CAPTCHA_PENYEDIA=
CAPTCHA_SITUS=
CAPTCHA_RAHASIA=

# --- Lain-lain ----------------------------------------------

# Matikan migrasi otomatis hanya bila kamu ingin menjalankannya manual.
APP_JALANKAN_MIGRASI=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
