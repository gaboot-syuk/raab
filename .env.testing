# ============================================================
# Lingkungan pengujian otomatis (PHPUnit)
#
# Laravel memuat berkas ini ALIH-ALIH `.env` ketika APP_ENV=testing.
# Tanpa berkas ini, `.env` pengembangan ikut terbaca dan nilai
# APP_ENV menjadi "local" — akibatnya proteksi CSRF tidak dilewati
# pada pengujian dan semua kiriman POST gagal dengan kode 419.
#
# Jalankan uji:  docker compose exec app php artisan test
# ============================================================
APP_NAME="PMII RAAB"
APP_ENV=testing
APP_KEY=base64:Bt/u2JjbfBE0S+RrmIJlN0QVUszXtW05tMvhlpAi14w=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- Log ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Basis data: SQLite di memori (tidak menyentuh data pengembangan) ---
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# --- Layanan lain: semua dibuat lokal & sinkron agar uji cepat ---
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=4
