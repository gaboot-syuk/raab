# ============================================================
# nginx — konfigurasi produksi
#
# Dijalankan di dalam wadah yang sama dengan php-fpm. Karena itu permintaan
# PHP diteruskan ke 127.0.0.1, bukan ke nama layanan lain.
#
# Port TIDAK ditulis di sini. Hosting gratis menentukan portnya lewat variabel
# lingkungan $PORT, dan berkas ini memakainya. Alamat yang ditulis tetap akan
# ditolak: wadahnya berjalan, tetapi tidak ada yang bisa menjangkaunya.
# ============================================================

worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Log ke keluaran standar supaya terbaca oleh log hosting.
    access_log /dev/stdout;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # Unggahan poster kegiatan dan berkas arsip bisa cukup besar.
    #
    # NILAI INI ADALAH BATAS KETIGA, dan dulu angkanya berbeda dari dua yang
    # lain — 25M di sini, 21M di post_max_size PHP, sedangkan kode aplikasi
    # menerima sampai 20 berkas sekaligus dengan batas 10 MB per berkas
    # (MediaController::MAKS_KB). Tiga angka yang berbeda artinya unggahan
    # banyak berkas gagal di tempat yang berbeda-beda pula, dan yang terlihat
    # pengurus selalu sama: modal galat tanpa penjelasan.
    #
    #   > 25 MB  → ditolak nginx (413), permintaannya tidak pernah sampai
    #              ke Laravel sehingga tidak ada catatan apa pun di log aplikasi
    #  21–25 MB  → sampai ke PHP, tetapi isinya DIBUANG karena post_max_size,
    #              sehingga token CSRF ikut hilang dan jawabannya 419
    #
    # Ketiganya harus sejalan. Angka di sini sama dengan post_max_size pada
    # Dockerfile; kalau salah satu diubah, ubah keduanya.
    client_max_body_size 224M;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml;

    server {
        listen ${PORT};
        server_name _;

        root /var/www/html/public;
        index index.php;

        charset utf-8;

        # Aset yang dibangun Vite diberi nama berisi cuplikan isi berkas, jadi
        # isinya tidak akan berubah selama namanya sama. Karena itu aman
        # disimpan lama di peramban — dan itu yang membuat kunjungan berikutnya
        # terasa jauh lebih cepat.
        location /build/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $document_root;
            include fastcgi_params;

            fastcgi_read_timeout 120;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
        }

        # Berkas tersembunyi (mis. .env) tidak boleh pernah bisa diunduh.
        location ~ /\. {
            deny all;
            return 404;
        }
    }
}
